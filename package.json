{
  "name": "branchport",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "description": "See which Git worktree and branch is serving each localhost port.",
  "repository": "github:wlrnjs/branchport",
  "keywords": ["chrome-extension", "git", "worktree", "localhost", "developer-tools"],
  "type": "module",
  "scripts": {
    "start": "node helper/server.js",
    "helper:install": "node helper/manage-service.js install",
    "helper:uninstall": "node helper/manage-service.js uninstall",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
