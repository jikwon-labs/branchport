{
  "name": "branchport",
  "version": "0.3.1",
  "packageManager": "pnpm@10.17.1",
  "description": "See which Git worktree and branch is serving each localhost port.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jikwon-labs/branchport.git"
  },
  "keywords": [
    "chrome-extension",
    "git",
    "worktree",
    "localhost",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "branchport": "helper/cli.js"
  },
  "files": [
    "helper/*.js",
    "helper/*.sh",
    "helper/*.ps1",
    "!helper/*.test.js"
  ],
  "scripts": {
    "start": "node helper/server.js",
    "helper:install": "node helper/cli.js install",
    "helper:uninstall": "node helper/cli.js uninstall",
    "test": "node --test",
    "package:extension": "node scripts/package-extension.js"
  },
  "engines": {
    "node": ">=20"
  }
}
